---
permalink: /api.json
---
{%- assign std = site.data.profielregister.standaard -%}
{%- comment -%} Alleen open diensten; wat geen open dienst is, staat in /diensten.json. {%- endcomment -%}
{%- assign alle = site.data.profielen[std].diensten | where_exp: "d", "d.open != false" | where_exp: "d", "d.soort != 'infrastructuur'" -%}
{
  "meta": {
    "title": "{{ site.title | escape }}",
    "description": "{{ site.description }}",
    "version": "1.0",
    "last_updated": "{{ site.time | date_to_xmlschema }}",
    "total_services": {{ alle | where: 'status', 'live' | size }}
  },
  "services": [
    {% assign diensten = alle | where: 'status', 'live' %}
    {% for dienst in diensten %}
    {%- include data/dienst.html dienst=dienst %}
    {
      "id": "{{ dienst.id }}",
      "name": {{ dienst.naam | jsonify }},
      {% if dn_sw %}"software": {{ dn_sw.naam | jsonify }},{% endif %}
      "description": {{ dienst.beschrijving | jsonify }},
      "category": "{{ dienst.categorie }}",
      "url": "{{ dienst.url }}",
      "favicon": {{ dn_sw.logo | default: dienst.favicon | jsonify }},
      {% if dn_org %}"provider": {{ dn_org.naam | jsonify }},{% endif %}
      {% if dn_org.logo %}"provider_favicon": {{ dn_org.logo | jsonify }},{% endif %}
      {% if dienst.spoelkeuken_url %}"spoelkeuken_url": "{{ dienst.spoelkeuken_url }}",{% endif %}
      "eu_hosting": {{ dienst.eu_hosting }},
      "status": "{{ dienst.status }}"
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "categories": [
    {% assign categories = alle | where: 'status', 'live' | map: 'categorie' | uniq | sort %}
    {% for category in categories %}
    {
      "name": "{{ category }}",
      "count": {{ alle | where: 'status', 'live' | where: 'categorie', category | size }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}